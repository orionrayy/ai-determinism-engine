{
  "capability:research": {
    "default_tool": "research_bundle",
    "fallback_tools": [
      "wikipedia"
    ],
    "description": "Evidence and web research"
  },
  "capability:analyze": {
    "default_tool": "gemini",
    "fallback_tools": [
      "openai"
    ],
    "description": "Reasoning and synthesis"
  },
  "capability:draft": {
    "default_tool": "gemini",
    "fallback_tools": [
      "openai"
    ],
    "description": "Drafting and transformation"
  },
  "capability:spec": {
    "default_tool": "gemini",
    "fallback_tools": [
      "openai"
    ],
    "description": "Technical specification"
  },
  "capability:build": {
    "default_tool": "github",
    "fallback_tools": [],
    "description": "Repository-backed implementation"
  },
  "capability:test": {
    "default_tool": "github",
    "fallback_tools": [],
    "description": "Repository-backed validation"
  },
  "capability:deploy": {
    "default_tool": "webhook",
    "fallback_tools": [],
    "description": "External deployment gateway"
  },
  "capability:validate": {
    "default_tool": "webhook",
    "fallback_tools": [],
    "description": "External validation gateway"
  },
  "capability:publish": {
    "default_tool": "webhook",
    "fallback_tools": [],
    "description": "External publishing gateway"
  },
  "capability:notify": {
    "default_tool": "webhook",
    "fallback_tools": [],
    "description": "External notification gateway"
  },
  "capability:execute": {
    "default_tool": "webhook",
    "fallback_tools": [],
    "description": "Generic external action"
  },
  "github": {
    "required_env": "GITHUB_TOKEN",
    "side_effects": [
      "repository_write",
      "issue_write"
    ]
  },
  "openai": {
    "required_env": "OPENAI_API_KEY",
    "side_effects": []
  },
  "webhook": {
    "required_env": "ORCHESTRATOR_WEBHOOK_URL",
    "side_effects": [
      "external_request"
    ]
  },
  "firecrawl": {
    "required_env": "FIRECRAWL_API_KEY",
    "side_effects": []
  },
  "noop": {
    "required_env": null,
    "side_effects": []
  },
  "wikipedia": {
    "required_env": null,
    "side_effects": []
  },
  "gemini": {
    "required_env": "GEMINI_API_KEY",
    "side_effects": []
  },
  "research_bundle": {
    "required_env": null,
    "side_effects": []
  }
}
