{
  "capability:research": {
    "default_tool": "research_bundle",
    "fallback_tools": [
      "wikipedia"
    ],
    "description": "Evidence and web research"
  },
  "capability:analyze": {
    "default_tool": "gemini",
    "fallback_tools": [
      "openai"
    ],
    "description": "Reasoning and synthesis"
  },
  "capability:draft": {
    "default_tool": "gemini",
    "fallback_tools": [
      "openai"
    ],
    "description": "Drafting and transformation"
  },
  "capability:spec": {
    "default_tool": "gemini",
    "fallback_tools": [
      "openai"
    ],
    "description": "Technical specification"
  },
  "capability:build": {
    "default_tool": "github",
    "fallback_tools": [],
    "description": "Repository-backed implementation"
  },
  "capability:test": {
    "default_tool": "github",
    "fallback_tools": [],
    "description": "Repository-backed validation"
  },
  "capability:deploy": {
    "default_tool": "webhook",
    "fallback_tools": [
      "connector_bridge"
    ],
    "description": "External deployment gateway"
  },
  "capability:validate": {
    "default_tool": "gemini",
    "fallback_tools": [
      "local_validator"
    ],
    "description": "Deterministic evidence/contract validation"
  },
  "capability:publish": {
    "default_tool": "webhook",
    "fallback_tools": [
      "connector_bridge"
    ],
    "description": "External publishing gateway"
  },
  "capability:notify": {
    "default_tool": "webhook",
    "fallback_tools": [
      "connector_bridge"
    ],
    "description": "External notification gateway"
  },
  "capability:execute": {
    "default_tool": "webhook",
    "fallback_tools": [
      "connector_bridge"
    ],
    "description": "Generic external action"
  },
  "github": {
    "required_env": "GITHUB_TOKEN",
    "side_effects": [
      "repository_write",
      "issue_write"
    ],
    "free_tier": true,
    "allowed_actions": [
      "metadata",
      "read_file",
      "create_issue",
      "create_or_update_file",
      "delete_file",
      "dispatch_workflow"
    ],
    "risk": "medium"
  },
  "openai": {
    "required_env": "OPENAI_API_KEY",
    "side_effects": [],
    "free_tier": false,
    "risk": "low"
  },
  "webhook": {
    "required_env": "ORCHESTRATOR_WEBHOOK_URL",
    "side_effects": [
      "external_request"
    ],
    "free_tier": false,
    "risk": "high"
  },
  "firecrawl": {
    "required_env": "FIRECRAWL_API_KEY",
    "side_effects": [],
    "free_tier": false,
    "risk": "low"
  },
  "noop": {
    "required_env": null,
    "side_effects": [],
    "free_tier": true,
    "risk": "low"
  },
  "wikipedia": {
    "required_env": null,
    "side_effects": [],
    "free_tier": true,
    "risk": "low"
  },
  "gemini": {
    "required_env": "GEMINI_API_KEY",
    "side_effects": [],
    "free_tier": true,
    "default_model": "gemini-3.8-flash",
    "free_models": [
      "gemini-3.8-flash",
      "gemini-3.7-flash",
      "gemini-3.6-flash",
      "gemini-3.5-flash"
    ],
    "risk": "low"
  },
  "research_bundle": {
    "required_env": null,
    "side_effects": [],
    "free_tier": true,
    "risk": "low"
  },
  "connector_bridge": {
    "required_env": "ORCHESTRATOR_CONNECTOR_BRIDGE_URL",
    "secret_env": "ORCHESTRATOR_CONNECTOR_BRIDGE_SECRET",
    "side_effects": [
      "external_request"
    ],
    "free_tier": true,
    "allowed_actions": [
      "invoke"
    ],
    "cost_model": "self-hosted/free-hostable; upstream vendor costs depend on configuration",
    "risk": "high"
  },
  "local_validator": {
    "required_env": null,
    "side_effects": [],
    "free_tier": true,
    "allowed_actions": [
      "validate"
    ],
    "risk": "low"
  },
  "capability:artifact_verify": {
    "default_tool": "artifact_verifier",
    "fallback_tools": [],
    "description": "Verify declared artifacts without side effects"
  },
  "artifact_verifier": {
    "required_env": null,
    "side_effects": [],
    "free_tier": true,
    "allowed_actions": [
      "verify"
    ],
    "risk": "low"
  },
  "capability:blueprint": {
    "default_tool": "blueprint_compiler",
    "fallback_tools": [],
    "description": "Deterministic workload blueprint normalization and bounded execution-unit compilation"
  },
  "blueprint_compiler": {
    "required_env": null,
    "side_effects": [],
    "free_tier": true,
    "risk": "low",
    "allowed_actions": [
      "compile"
    ],
    "description": "Side-effect-free structured blueprint compiler"
  }
}
