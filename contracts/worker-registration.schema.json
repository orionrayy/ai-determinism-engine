{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://ai-determinism-engine.local/contracts/worker-registration.schema.json",
  "title":"AI Determinism Engine Worker Registration",
  "type":"object",
  "additionalProperties":false,
  "required":["protocol_version","worker_id","build_id","capabilities","skill_versions","trust_level","network_class","resources","health","drain_state"],
  "properties":{
    "protocol_version":{"type":"string","minLength":1,"maxLength":32},
    "worker_id":{"type":"string","minLength":1,"maxLength":128},
    "build_id":{"type":"string","minLength":1,"maxLength":128},
    "capabilities":{"type":"array","items":{"type":"string","maxLength":128},"minItems":1,"maxItems":128,"uniqueItems":true},
    "skill_versions":{
      "type":"object",
      "additionalProperties":{"type":"string","maxLength":64},
      "maxProperties":256
    },
    "trust_level":{"type":"string","enum":["untrusted","standard","trusted","isolated"]},
    "network_class":{"type":"string","maxLength":64},
    "resources":{
      "type":"object","additionalProperties":false,
      "required":["cpu_class","memory_mb","max_slots","available_slots"],
      "properties":{
        "cpu_class":{"type":"string","maxLength":64},
        "memory_mb":{"type":"integer","minimum":1,"maximum":1048576},
        "max_slots":{"type":"integer","minimum":1,"maximum":4096},
        "available_slots":{"type":"integer","minimum":0,"maximum":4096},
        "accelerator":{"type":"string","maxLength":128}
      }
    },
    "health":{
      "type":"object","additionalProperties":false,
      "required":["status","heartbeat_at"],
      "properties":{
        "status":{"type":"string","enum":["ready","degraded","quarantined"]},
        "heartbeat_at":{"type":"string","format":"date-time"},
        "failure_streak":{"type":"integer","minimum":0},
        "last_success_at":{"type":["string","null"],"format":"date-time"}
      }
    },
    "drain_state":{
      "type":"object","additionalProperties":false,
      "required":["mode"],
      "properties":{
        "mode":{"type":"string","enum":["active","drain_requested","draining","retired"]},
        "requested_at":{"type":["string","null"],"format":"date-time"}
      }
    },
    "metadata":{"type":"object","additionalProperties":true}
  }
}