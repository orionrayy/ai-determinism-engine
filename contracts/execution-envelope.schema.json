{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cross-Service Execution Envelope",
  "type": "object",
  "required": ["schema_version", "execution_id", "workflow_id", "event_id", "domain", "operation", "intent_fingerprint", "idempotency_key", "attempt", "source", "requested_mode", "input"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "execution_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "workflow_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "parent_execution_id": {"type": ["string", "null"], "maxLength": 128},
    "event_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "domain": {"type": "string", "minLength": 1, "maxLength": 64},
    "operation": {"type": "string", "minLength": 1, "maxLength": 128},
    "intent_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 128},
    "attempt": {"type": "integer", "minimum": 1, "maximum": 1000},
    "source": {"type": "string", "minLength": 1, "maxLength": 128},
    "requested_mode": {"enum": ["dry-run", "live"]},
    "input": {"type": "object"}
  },
  "additionalProperties": false
}
