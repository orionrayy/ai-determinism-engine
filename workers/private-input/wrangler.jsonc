{
  "name": "ai-orchestrator-private-input",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "PRIVATE_INPUTS",
        "class_name": "PrivateInput"
      },
      {
        "name": "EXECUTION_LEASES",
        "class_name": "ExecutionLease"
      }
    ]
  },
  "exports": {
    "PrivateInput": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "ExecutionLease": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "secrets": {
    "required": ["ORCHESTRATOR_PRIVATE_INPUT_SECRET"]
  }
}
