{
  "name": "ai-orchestrator-private-input",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "PrivateInput",
        "ExecutionLease"
      ]
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PRIVATE_INPUTS",
        "class_name": "PrivateInput"
      },
      {
        "name": "EXECUTION_LEASES",
        "class_name": "ExecutionLease"
      }
    ]
  },
  "secrets": {
    "required": ["ORCHESTRATOR_PRIVATE_INPUT_SECRET"]
  }
}
